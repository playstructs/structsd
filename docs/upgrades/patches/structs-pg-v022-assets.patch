+++ b/deploy/table-ledger-20260921-denomination-identity.sql
@@ -0,0 +1,12 @@
+-- Deploy structs-pg:table-ledger-20260921-denomination-identity to pg
+-- Stop the indexer while applying this migration and its paired writer update.
+-- Preserve the established leg encoding; denomination distinguishes coin rows.
+BEGIN;
+ALTER TABLE structs.ledger ADD CONSTRAINT ledger_source_denom_required_chk
+    CHECK (chain_id IS NULL OR (denom IS NOT NULL AND denom <> ''));
+DROP INDEX structs.ledger_source_event_uidx;
+CREATE UNIQUE INDEX ledger_source_event_uidx
+    ON structs.ledger (time, chain_id, tx_index, msg_index, event_index, denom);
+COMMENT ON INDEX structs.ledger_source_event_uidx IS
+    'Replay identity includes denomination; the encoded event/leg is unchanged for existing coins.';
+COMMIT;
diff --git a/revert/table-ledger-20260921-denomination-identity.sql b/revert/table-ledger-20260921-denomination-identity.sql
