diff --git a/verify/table-ledger-20260921-denomination-identity.sql b/verify/table-ledger-20260921-denomination-identity.sql
new file mode 100644
index 0000000..2757289
--- /dev/null
+++ b/verify/table-ledger-20260921-denomination-identity.sql
@@ -0,0 +1,20 @@
+-- Verify structs-pg:table-ledger-20260921-denomination-identity on pg
+BEGIN;
+DO $$
+DECLARE columns text[];
+BEGIN
+ SELECT array_agg(a.attname::text ORDER BY key.ordinality) INTO columns
+ FROM pg_index i
+ CROSS JOIN LATERAL unnest(i.indkey) WITH ORDINALITY AS key(attnum, ordinality)
+ JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = key.attnum
+ WHERE i.indexrelid = 'structs.ledger_source_event_uidx'::regclass
+   AND i.indrelid = 'structs.ledger'::regclass AND i.indisunique AND i.indisvalid;
+ IF columns IS DISTINCT FROM ARRAY['time','chain_id','tx_index','msg_index','event_index','denom'] THEN
+  RAISE EXCEPTION 'incorrect ledger replay index: %', columns;
+ END IF;
+ IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = 'structs.ledger'::regclass
+   AND conname = 'ledger_source_denom_required_chk' AND convalidated) THEN
+  RAISE EXCEPTION 'missing validated ledger denomination constraint';
+ END IF;
+END $$;
+ROLLBACK;
