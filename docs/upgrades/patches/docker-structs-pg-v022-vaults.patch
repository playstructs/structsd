+package events
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/jackc/pgx/v5"
+	"sync-state/internal/payload"
+)
+
+// Vaults own assets; they are never signing keys in player_address.
+type vaultAddressHandler struct{}
+
+func (vaultAddressHandler) CompositeKey() string {
+	return "structs.structs.EventVaultAddress.eventVaultAddressDetail"
+}
+
+type vaultAddressPayload struct {
+	OwnerID        string          `json:"ownerId"`
+	Address        string          `json:"vaultAddress"`
+	AccountNumber  json.RawMessage `json:"accountNumber"`
+	AccountCreated *bool           `json:"accountCreated"`
+}
+
+func (vaultAddressHandler) Handle(ctx context.Context, tx pgx.Tx, bctx BlockContext, raw json.RawMessage) error {
+	p, err := payload.Decode[vaultAddressPayload](raw)
+	if err != nil {
+		return err
+	}
+	parts := strings.Split(p.OwnerID, "-")
+	if len(parts) != 2 || (parts[0] != "0" && parts[0] != "1") {
+		return fmt.Errorf("vault: invalid owner %q", p.OwnerID)
+	}
+	index, err := strconv.ParseUint(parts[1], 10, 64)
+	if err != nil || index == 0 || strconv.FormatUint(index, 10) != parts[1] {
+		return fmt.Errorf("vault: noncanonical owner %q", p.OwnerID)
+	}
+	if p.Address == "" || p.AccountCreated == nil {
+		return fmt.Errorf("vault: missing address or accountCreated")
+	}
+	number := string(p.AccountNumber)
+	if len(number) > 0 && number[0] == '"' {
+		if err = json.Unmarshal(p.AccountNumber, &number); err != nil {
+			return err
+		}
+	}
+	account, err := strconv.ParseUint(number, 10, 64)
+	if err != nil {
+		return fmt.Errorf("vault: invalid account number: %w", err)
+	}
+	kind := "player"
+	if parts[0] == "0" {
+		kind = "guild"
+	}
+	var owner string
+	err = tx.QueryRow(ctx, `
+INSERT INTO structs.vault(owner_id,owner_type,address,account_number,account_created,created_at,updated_at)
+VALUES ($1,$2::structs.object_type,$3,$4::numeric,$5,$6,$6)
+ON CONFLICT (owner_id) DO UPDATE
+ SET account_created=EXCLUDED.account_created, updated_at=EXCLUDED.updated_at
+ WHERE structs.vault.address=EXCLUDED.address
+   AND structs.vault.account_number=EXCLUDED.account_number
+RETURNING owner_id`, p.OwnerID, kind, p.Address, strconv.FormatUint(account, 10), *p.AccountCreated, bctx.BlockTime).Scan(&owner)
+	if err != nil {
+		return fmt.Errorf("vault association %s: %w", p.OwnerID, err)
+	}
+	bctx.Dirty.Address(p.Address)
+	if kind == "player" {
+		bctx.Dirty.Player(p.OwnerID)
+	} else {
+		bctx.Dirty.Guild(p.OwnerID)
+	}
+	return nil
+}
