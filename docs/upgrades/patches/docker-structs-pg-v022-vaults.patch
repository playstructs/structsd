diff --git a/sync-state/internal/readmodel/vault_inventory_test.go b/sync-state/internal/readmodel/vault_inventory_test.go
new file mode 100644
index 0000000..b3973e3
--- /dev/null
+++ b/sync-state/internal/readmodel/vault_inventory_test.go
@@ -0,0 +1,99 @@
+package readmodel
+
+import (
+	"context"
+	"github.com/jackc/pgx/v5"
+	"sync-state/internal/buffers"
+	"testing"
+)
+
+func TestVaultInventoryAllRefreshPaths(t *testing.T) {
+	integrationTx(t, func(ctx context.Context, tx pgx.Tx) {
+		exec := func(sql string, args ...any) {
+			t.Helper()
+			if _, err := tx.Exec(ctx, sql, args...); err != nil {
+				t.Fatal(err)
+			}
+		}
+		exec("INSERT INTO structs.player(id,guild_id) VALUES ('1-999100','0-999100')")
+		exec("INSERT INTO structs.player_address(address,player_id,guild_id) VALUES ('old-signer','1-999100','0-999100'),('retained-signer','1-999100','0-999100')")
+		exec("INSERT INTO structs.vault(owner_id,owner_type,address,account_number,account_created,created_at,updated_at) VALUES ('1-999100','player','player-vault',101,true,NOW(),NOW()),('0-999100','guild','guild-vault',102,true,NOW(),NOW())")
+		exec("INSERT INTO structs.ledger(address,amount_p,denom,direction) VALUES ('old-signer',100,'ualpha','credit'),('old-signer',100,'ualpha','debit'),('retained-signer',7,'ualpha','credit'),('player-vault',100,'ualpha','credit'),('guild-vault',25,'ualpha','credit'),('collateral-pool',99,'ualpha','credit')")
+		check := func(player string) {
+			t.Helper()
+			for _, want := range []struct{ kind, id, amount string }{{"player", "1-999100", player}, {"guild", "0-999100", "25"}} {
+				var amount string
+				if err := tx.QueryRow(ctx, "SELECT balance::text FROM structs.api_inventory WHERE owner_type=$1::structs.object_type AND owner_id=$2 AND denom='ualpha'", want.kind, want.id).Scan(&amount); err != nil || amount != want.amount {
+					t.Fatalf("%s: got %s want %s (%v)", want.kind, amount, want.amount, err)
+				}
+			}
+			var drift int
+			if err := tx.QueryRow(ctx, "SELECT count(*) FROM structs.api_inventory_reconcile(false)").Scan(&drift); err != nil || drift != 0 {
+				t.Fatalf("drift=%d (%v)", drift, err)
+			}
+		}
+		if err := backfillInventory(ctx, tx); err != nil {
+			t.Fatal(err)
+		}
+		check("107")
+		// A later bank credit only dirties the vault address; ownership must expand.
+		exec("INSERT INTO structs.ledger(address,amount_p,denom,direction) VALUES ('player-vault',5,'ualpha','credit')")
+		d := NewDirty()
+		d.Address("player-vault")
+		if err := expandAddresses(ctx, tx, d); err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := d.Players["1-999100"]; !ok {
+			t.Fatal("vault did not resolve to player")
+		}
+		if err := applyInventoryDeltas(ctx, tx, d, []buffers.LedgerDelta{{Address: "player-vault", Denom: "ualpha", Delta: "5"}}); err != nil {
+			t.Fatal(err)
+		}
+		check("112")
+		// Nightly repair must use the same ownership rules, including guilds.
+		exec("UPDATE structs.api_inventory SET balance=999 WHERE owner_type IN ('player','guild') OR (owner_type='address' AND owner_id IN ('player-vault','guild-vault'))")
+		var drift int
+		if err := tx.QueryRow(ctx, "SELECT count(*) FROM structs.api_inventory_reconcile(true)").Scan(&drift); err != nil || drift != 4 {
+			t.Fatalf("expected four corrupt rows, got %d (%v)", drift, err)
+		}
+		if repaired, err := ConsumeDrift(ctx, tx); err != nil || repaired != 4 {
+			t.Fatalf("repair=%d (%v)", repaired, err)
+		}
+		check("112")
+		var treasury string
+		if err := tx.QueryRow(ctx, "SELECT balance::text FROM view.guild_vault_inventory WHERE guild_id='0-999100' AND denom='ualpha'").Scan(&treasury); err != nil || treasury != "25" {
+			t.Fatalf("treasury=%s (%v)", treasury, err)
+		}
+		dg := NewDirty()
+		dg.Address("guild-vault")
+		if err := expandAddresses(ctx, tx, dg); err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := dg.Guilds["0-999100"]; !ok {
+			t.Fatal("guild vault did not dirty guild")
+		}
+		// A repair with only an owner marked must reach all owned addresses.
+		exec("UPDATE structs.api_inventory SET balance=999 WHERE owner_type IN ('player','guild')")
+		d = NewDirty()
+		d.Player("1-999100")
+		d.Guild("0-999100")
+		if err := recomputeInventory(ctx, tx, d); err != nil {
+			t.Fatal(err)
+		}
+		check("112")
+		if err := backfillInventory(ctx, tx); err != nil {
+			t.Fatal(err)
+		}
+		check("112")
+		// Reassigning a signing address moves only its remaining funds, not the vault.
+		exec("INSERT INTO structs.player(id) VALUES ('1-999101')")
+		exec("UPDATE structs.player_address SET player_id='1-999101' WHERE address='retained-signer'")
+		d = NewDirty()
+		d.Player("1-999100")
+		d.Player("1-999101")
+		if err := applyInventoryDeltas(ctx, tx, d, nil); err != nil {
+			t.Fatal(err)
+		}
+		check("105")
+	})
+}
