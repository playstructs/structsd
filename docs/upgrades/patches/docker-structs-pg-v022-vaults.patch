+)
+
+func TestVaultRejectsMalformedBeforeWriting(t *testing.T) {
+	for _, bad := range []map[string]any{{"ownerId": "2-1"}, {"ownerId": "1-0"}, {"ownerId": "1-01"}, {"ownerId": "1-18446744073709551616"}, {"vaultAddress": ""}, {"accountNumber": "-1"}, {"accountNumber": "18446744073709551616"}, {"accountNumber": "1.5"}, {"accountCreated": "false"}, {"accountCreated": nil}} {
+		p := map[string]any{"ownerId": "1-999001", "vaultAddress": "vault-player", "accountNumber": "18446744073709551615", "accountCreated": false}
+		for k, v := range bad {
+			p[k] = v
+		}
+		raw, _ := json.Marshal(p)
+		if err := (vaultAddressHandler{}).Handle(context.Background(), nil, fixedBctx(1), raw); err == nil {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+}
+func TestVaultAssociationReplayAndIsolation(t *testing.T) {
+	conn := connect(t)
+	inTx(t, conn, func(tx pgx.Tx) {
+		ctx := context.Background()
+		bc := fixedBctx(9)
+		r := NewRouter(false)
+		rows := []map[string]any{
+			{"ownerId": "1-999001", "vaultAddress": "vault-player", "accountNumber": "18446744073709551615", "accountCreated": true},
+			{"ownerId": "0-999001", "vaultAddress": "vault-guild", "accountNumber": "0", "accountCreated": false},
+		}
+		for _, p := range rows {
+			raw, _ := json.Marshal(p)
+			// Exercise the production role, including the router's savepoint.
+			if _, err := tx.Exec(ctx, "SET LOCAL ROLE structs_indexer"); err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 2; i++ {
+				he, fatal := r.Dispatch(ctx, tx, bc, "structs.structs.EventVaultAddress.eventVaultAddressDetail", raw)
+				if he != nil || fatal != nil {
+					t.Fatalf("handler: %v / %v", he, fatal)
+				}
+			}
+			if _, err := tx.Exec(ctx, "RESET ROLE"); err != nil {
+				t.Fatal(err)
+			}
+			var address, number string
+			if err := tx.QueryRow(ctx, "SELECT address,account_number::text FROM structs.vault WHERE owner_id=$1", p["ownerId"]).Scan(&address, &number); err != nil {
+				t.Fatal(err)
+			}
+			if address != p["vaultAddress"] || number != p["accountNumber"] {
+				t.Fatal(address, number)
+			}
+		}
+		var n int
+		if err := tx.QueryRow(ctx, "SELECT count(*) FROM structs.player_address WHERE address IN ('vault-player','vault-guild')").Scan(&n); err != nil || n != 0 {
+			t.Fatalf("vault became signer: %d %v", n, err)
+		}
+		for _, bad := range []map[string]any{
+			{"ownerId": "1-999001", "vaultAddress": "replacement", "accountNumber": "18446744073709551615", "accountCreated": false},
+			{"ownerId": "1-999002", "vaultAddress": "vault-player", "accountNumber": "3", "accountCreated": false},
+			{"ownerId": "1-999001", "vaultAddress": "vault-player", "accountNumber": "3", "accountCreated": false},
+		} {
+			raw, _ := json.Marshal(bad)
+			he, fatal := r.Dispatch(ctx, tx, bc, "structs.structs.EventVaultAddress.eventVaultAddressDetail", raw)
+			if he == nil || fatal != nil {
+				t.Fatalf("conflicting association accepted: %v %v", he, fatal)
+			}
+		}
+		if err := tx.QueryRow(ctx, "SELECT count(*) FROM structs.vault WHERE owner_id IN ('1-999001','0-999001')").Scan(&n); err != nil || n != 2 {
+			t.Fatalf("associations changed: %d %v", n, err)
+		}
+		if _, ok := bc.Dirty.Players["1-999001"]; !ok {
+			t.Fatal("player was not dirtied")
+		}
+		if _, ok := bc.Dirty.Guilds["0-999001"]; !ok {
+			t.Fatal("guild was not dirtied")
+		}
+	})
+}
