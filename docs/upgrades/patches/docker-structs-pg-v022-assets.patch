+type eventCoin struct{ amount, denom string }
+
+// Validate the entire list before writing any rows. Unknown/malformed tails
+// must not silently turn a multi-asset transfer into a partial transfer.
+func findAmounts(ev rpc.Event) ([]eventCoin, error) {
+	value := findAttr(ev, "amount")
+	if value == "" {
+		return nil, nil
+	}
+	parts := strings.Split(value, ",")
+	coins := make([]eventCoin, 0, len(parts))
+	seen := make(map[string]bool, len(parts))
+	for _, part := range parts {
+		amount, denom, ok := parseAmountDenom(part)
+		if !ok {
+			return nil, fmt.Errorf("invalid coin %q", part)
+		}
+		if seen[denom] {
+			return nil, fmt.Errorf("duplicate denomination %q", denom)
+		}
+		seen[denom] = true
+		coins = append(coins, eventCoin{amount, denom})
+	}
+	return coins, nil
+}
