+func TestProcessBlock_AllDenoms(t *testing.T) {
+	coins := []struct{ amount, denom string }{
+		{"9007199254740993", "ualpha"},
+		{"25", "ibc/" + strings.Repeat("AB", 32)},
+		{"31", "factory/structs1issuer/token_name:series-1"},
+	}
+	for i := 0; i < 20; i++ {
+		coins = append(coins, struct{ amount, denom string }{fmt.Sprint(i + 1), fmt.Sprintf("utoken%d", i)})
+	}
+	amounts := make([]string, len(coins))
+	for i, coin := range coins {
+		amounts[i] = coin.amount + coin.denom
+	}
+	for _, kind := range []string{"transfer", "coinbase", "burn"} {
+		t.Run(kind, func(t *testing.T) {
+			event := rpc.Event{Type: kind, Attributes: []rpc.Attribute{{Key: "sender", Value: "sender"}, {Key: "recipient", Value: "vault"}, {Key: "minter", Value: "vault"}, {Key: "burner", Value: "vault"}, {Key: "amount", Value: strings.Join(amounts, ",")}}}
+			next := transferEvent("other", "vault", "7ualpha")
+			buf := buffers.New()
+			if err := ProcessBlock(context.Background(), nil, buf, 23, time.Unix(42, 0), "test", []rpc.Event{event, next}, nil); err != nil {
+				t.Fatal(err)
+			}
+			legs := 1
+			if kind == "transfer" {
+				legs = 2
+			}
+			if len(buf.Ledger) != legs*len(amounts)+2 {
+				t.Fatalf("got %d rows, want %d", len(buf.Ledger), legs*len(amounts)+2)
+			}
+			seen := map[string]bool{}
+			for _, row := range buf.Ledger {
+				// The schema's replay identity includes denomination. Existing single-coin
+				// event indexes stay unchanged; an arbitrary coin count cannot spill into
+				// the next chain event's eight leg slots.
+				key := fmt.Sprintf("%d/%d/%d/%s", row.TxIndex, row.MsgIndex, row.EventIndex, row.Denom)
+				if seen[key] {
+					t.Fatalf("duplicate identity %s", key)
+				}
+				seen[key] = true
+			}
+			for i, coin := range coins {
+				for leg := 0; leg < legs; leg++ {
+					row := buf.Ledger[i*legs+leg]
+					if row.AmountP != coin.amount || row.Denom != coin.denom || row.EventIndex != leg {
+						t.Fatalf("lost coin/identity: %+v", row)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestProcessBlock_RejectsMalformedCoinLists(t *testing.T) {
+	for _, amount := range []string{"100ualpha,", "100ualpha,3ualpha", "100ualpha,-2uguild", "100ualpha,2ibc/HASH!", "100ualpha,2u", "100ualpha,garbage"} {
+		for _, kind := range []string{"transfer", "coinbase", "burn"} {
+			t.Run(kind+"/"+amount, func(t *testing.T) {
+				ev := transferEvent("sender", "vault", amount)
+				ev.Type = kind
+				buf := buffers.New()
+				if err := ProcessBlock(context.Background(), nil, buf, 1, time.Unix(1, 0), "test", []rpc.Event{ev}, nil); err == nil {
+					t.Fatal("malformed list accepted")
+				}
+				if len(buf.Ledger) != 0 {
+					t.Fatalf("partial list created %d ledger rows", len(buf.Ledger))
+				}
+			})
+		}
+	}
+}
+
+func TestProcessBlock_MultiDenomReplay(t *testing.T) {
+	conn := connect(t)
+	inTx(t, conn, func(tx pgx.Tx) {
+		ctx := context.Background()
+		stamp := fixedTime()
+		const height = 7331
+		first := transferEvent("v022sender", "v022vault", "100ualpha")
+		both := transferEvent("v022sender", "v022vault", "100ualpha,25uguild")
+		for i, ev := range []rpc.Event{first, both, both} {
+			buf := buffers.New()
+			if err := ProcessBlock(ctx, tx, buf, height, stamp, "v022-coins", []rpc.Event{ev}, nil); err != nil {
+				t.Fatal(err)
+			}
+			deltas, err := buf.Flush(ctx, tx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := 2
+			if i == 2 {
+				want = 0
+			}
+			if len(deltas) != want {
+				t.Fatalf("pass %d: %d newly inserted rows, want %d", i, len(deltas), want)
+			}
+			for _, delta := range deltas {
+				denom, amount := "ualpha", "100"
+				if i == 1 {
+					denom, amount = "uguild", "25"
+				}
+				if delta.Address == "v022sender" {
+					amount = "-" + amount
+				} else if delta.Address != "v022vault" {
+					t.Fatal(delta)
+				}
+				if delta.Denom != denom || delta.Delta != amount {
+					t.Fatalf("wrong persisted delta: %+v", delta)
+				}
+			}
+		}
+		if n := queryLedgerCount(t, tx, "chain_id = $1 AND block_height = $2", "v022-coins", height); n != 4 {
+			t.Fatalf("got %d persisted rows", n)
+		}
+	})
+}
+
+func TestProcessBlock_GameplayKeepsOtherDenoms(t *testing.T) {
+	for _, action := range []string{"/structs.structs.MsgStructGeneratorInfuse", "/structs.structs.MsgStructOreRefineryComplete"} {
+		t.Run(action, func(t *testing.T) {
+			buf := buffers.New()
+			group := []rpc.Event{transferEvent("source", "destination", "100ualpha,25uguild"), {Type: "message", Attributes: []rpc.Attribute{{Key: "action", Value: action}}}}
+			if err := ProcessBlock(context.Background(), nil, buf, 1, time.Unix(1, 0), "test", group, nil); err != nil {
+				t.Fatal(err)
+			}
+			if len(buf.Ledger) != 3 {
+				t.Fatalf("got %d rows", len(buf.Ledger))
+			}
+			for i, row := range buf.Ledger[1:] {
+				wantDirection, wantAddress := "debit", "source"
+				if i == 1 {
+					wantDirection, wantAddress = "credit", "destination"
+				}
+				if row.Denom != "uguild" || row.AmountP != "25" || row.Direction != wantDirection || row.Address != wantAddress {
+					t.Fatalf("lost unrelated coin: %+v", row)
+				}
+			}
+		})
+	}
+}
