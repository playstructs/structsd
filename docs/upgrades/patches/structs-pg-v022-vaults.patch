+-- Revert structs-pg:table-ledger-20260921-denomination-identity from pg
+-- Intentionally refuses if multiple coin rows already share the old identity.
+-- Never discard those assets just to make a rollback succeed.
+BEGIN;
+DROP INDEX structs.ledger_source_event_uidx;
+CREATE UNIQUE INDEX ledger_source_event_uidx
+    ON structs.ledger (time, chain_id, tx_index, msg_index, event_index);
+ALTER TABLE structs.ledger DROP CONSTRAINT ledger_source_denom_required_chk;
+COMMIT;
