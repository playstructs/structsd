+++ b/verify/table-vault-20260921-asset-owners.sql
@@ -0,0 +1,11 @@
+-- Verify structs-pg:table-vault-20260921-asset-owners on pg
+BEGIN;
+SELECT owner_id,owner_type,address,account_number,account_created FROM structs.vault WHERE FALSE;
+SELECT owner_type,owner_id,address FROM structs.asset_owner_address WHERE FALSE;
+SELECT guild_id,denom,balance FROM view.guild_vault_inventory WHERE FALSE;
+DO $$ BEGIN
+ IF EXISTS (SELECT 1 FROM unnest(ARRAY['INSERT','UPDATE','DELETE','SELECT']) AS p(privilege) WHERE NOT has_table_privilege('structs_indexer','structs.vault',p.privilege))
+ OR NOT has_table_privilege('structs_webapp','view.guild_vault_inventory','SELECT') THEN
+ RAISE EXCEPTION 'missing vault grants'; END IF;
+END $$;
+ROLLBACK;
